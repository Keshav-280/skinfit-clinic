{
  "name": "skinfit-clinic",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/shared",
    "apps/ml-worker"
  ],
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:with-mediapipe": "npm run mediapipe:sync-wasm && next build",
    "start": "next start -H 0.0.0.0",
    "worker:dev": "npm run dev --workspace=@skinfit/ml-worker",
    "worker:start": "npm run start --workspace=@skinfit/ml-worker",
    "docker:up": "docker compose -f docker/docker-compose.yml up",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:verify-aws": "tsx src/scripts/verify-aws-rds.ts",
    "db:bootstrap-aws": "tsx src/scripts/bootstrap-aws-rds.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:delete-all-doctors": "tsx src/scripts/delete-all-doctors.ts",
    "db:seed:rag-demo": "tsx src/db/seed-rag-kai-demo.ts",
    "rag:index:textbook": "tsx src/scripts/build-rag-textbook-index.ts",
    "rag:pinecone:upsert": "tsx src/scripts/rag-pinecone-upsert.ts",
    "verify:dual-pose": "tsx src/scripts/verify-dual-pose-pipeline.ts",
    "mediapipe:sync-wasm": "mkdir -p public/mediapipe-wasm && cp -R node_modules/@mediapipe/tasks-vision/wasm/. public/mediapipe-wasm/",
    "capture:setup-models": "bash scripts/setup-capture-models.sh"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.22.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@neondatabase/serverless": "0.10.4",
    "@pinecone-database/pinecone": "^6.1.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "framer-motion": "^12.34.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^1.6.7",
    "html2pdf.js": "^0.14.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "next": "16.1.6",
    "nodemailer": "^8.0.4",
    "openai": "^6.25.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
