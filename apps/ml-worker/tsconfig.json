{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../../*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "../../src/**/*.ts"],
  "exclude": ["../../src/**/*.test.ts", "../../src/scripts/**"]
}
