# Optional HTTPS on the VM (Let's Encrypt certs on host or in /etc/letsencrypt).
# 1. Copy to skinfit-ssl.conf (not .example)
# 2. Replace YOUR_DOMAIN
# 3. Mount certs in docker-compose.prod.yml (see nginx/README.md)
#
# Uses Docker embedded DNS (127.0.0.11) so nginx starts even when `web` is
# still booting — static upstream blocks fail with "host not found in upstream".

# Public HTTP → HTTPS (browser traffic)
server {
  listen 80;
  listen [::]:80;
  server_name YOUR_DOMAIN;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name YOUR_DOMAIN;

  ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;

  client_max_body_size 64m;

  access_log /var/log/nginx/skinfit.access.log;
  error_log /var/log/nginx/skinfit.error.log warn;

  resolver 127.0.0.11 valid=10s ipv6=off;

  location ~ ^/api/chat/plain/(inbox-stream|stream) {
    set $skinfit_upstream web:3000;
    proxy_pass http://$skinfit_upstream;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding on;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /healthz {
    access_log off;
    return 200 "ok\n";
    add_header Content-Type text/plain;
  }

  location / {
    set $skinfit_upstream web:3000;
    proxy_pass http://$skinfit_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }
}
