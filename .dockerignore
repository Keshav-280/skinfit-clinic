# Ignore node package dependencies (they are installed inside the docker container)
**/node_modules
node_modules

# Ignore local Next.js build caches
**/.next
.next

# Ignore mobile native app entirely (not needed for web/ml-worker backend services)
mobile/
**/.expo
.expo

# Ignore books documentation
books/

# Ignore face_analysis_tool repo (mounted read-only into ml-inference at runtime)
face_analysis_tool/

# Ignore local ML weights (mounted via volume at runtime), EXCEPT the acne
# detector model which is baked into the acne-detector image.
models/*
!models/acne-detector
models/acne-detector/*
!models/acne-detector/best.pt

# Ignore local uploaded files and media caches
**/uploads
uploads

# Ignore git and local environment files
.git
.gitignore
.github
*.local
*.env.local

# Ignore OS files
**/.DS_Store
.DS_Store
