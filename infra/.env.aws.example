# AWS production — copy to repo root as .env.aws (gitignored).
# Use ONLY for one-off migrations or when explicitly targeting RDS from a trusted network path.
# Do not commit real passwords.

# Prefer RDS console → Databases → skinfit-db → Connectivity → Endpoint (must match exactly)
# CloudFormation Output RDSEndpoint should match; if migrate fails with NXDOMAIN, re-copy from RDS
# User: skinfit  |  DB: skinfit  |  Port: 5432
# Password: value you entered for stack parameter DBPassword (not the template default in git)
AWS_RDS_URL=postgresql://skinfit:REPLACE_PASSWORD@REPLACE_RDSEndpoint:5432/skinfit

# After stack update — Outputs → ElastiCacheUrl (inside VPC only; not for laptop)
# ELASTICACHE_URL=redis://skinfit-redis.xxxxx.0001.aps1.cache.amazonaws.com:6379

# Keep local storage until R2 phase
# STORAGE_DRIVER=local

# When running app against AWS DB from laptop (only if migration path allows TCP to RDS):
# unset LOCAL_POSTGRES_URL
# export AWS_RDS_URL=...
