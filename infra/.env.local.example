# Local Docker stack — copy to repo root as .env.local
# Required for: npm run dev, npm run worker:dev, and docker compose (env_file).

# Host ports 5433 / 6380 avoid clashes with other local Docker stacks (e.g. rag_protocol on 5432/6379)
LOCAL_POSTGRES_URL=postgresql://skinfit:skinfit_local_dev@127.0.0.1:5433/skinfit
LOCAL_REDIS_URL=redis://127.0.0.1:6380
LOCAL_STORAGE_ROOT=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:3000/api/files

SCAN_ASYNC_MODE=1
STORAGE_DRIVER=local

# Face analysis (must match between worker/web and ml-inference)
# Host worker:dev → http://127.0.0.1:8765 (inference published on 8765)
# Docker compose overrides URL to http://ml-inference:8765 inside containers
FACE_ANALYSIS_SERVICE_URL=http://127.0.0.1:8765
# Worker/web send this as HTTP header X-API-Key
FACE_ANALYSIS_SERVICE_SECRET=local-dev-key
# ml-inference (api_server.py) reads this; use the same value as SERVICE_SECRET
FACE_ANALYSIS_API_KEY=local-dev-key

# MediaPipe live capture (on by default). Disable with:
# NEXT_PUBLIC_DISABLE_MEDIAPIPE=1
# EXPO_PUBLIC_DISABLE_MEDIAPIPE=1

# Face identity gate — blocks scans that don't match onboarding centre photo
FACE_IDENTITY_VERIFICATION=1
# Cosine similarity threshold (0.2–0.95). Higher = stricter. Default 0.42 (front profile)
# FACE_IDENTITY_MATCH_THRESHOLD=0.42
# Lower threshold for side profiles. Default: front − 0.10 (min 0.28)
# FACE_IDENTITY_PROFILE_MATCH_THRESHOLD=0.32
# Python embedder: pip install -r apps/ml-worker/python/requirements-identity.txt
# CAPTURE_PREVIEW_PYTHON=python3

# Legacy Neon (optional if not using local Postgres)
# DATABASE_URL=postgresql://...

# AWS RDS (production) — see infra/.env.aws.example and infra/MASTER_CTO_PLAN.md
# AWS_RDS_URL=postgresql://skinfit:...@....rds.amazonaws.com:5432/skinfit
