# Cloudflare R2 — copy values into ECS (web + ml-worker) or .env.local for testing.
# Never commit real secrets.

STORAGE_DRIVER=r2

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=skinfit-uploads-prod

# Optional override (default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com

PUBLIC_UPLOAD_BASE_URL=https://your-alb-or-domain/api/files
