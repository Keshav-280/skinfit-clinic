# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local object storage + ML weights
/images_face/
/uploads/
/models/checkpoints/
/models/*.pth
/models/*.pt
/models/capture/*.onnx

# misc
.DS_Store
*.pem

# Textbook PDFs — large / licensing; not needed in git if RAG chunks live in Pinecone
books/**/*.pdf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment — never commit secrets (examples are allowed via !.env.example)
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test.local
mobile/.env
!.env.example
!mobile/.env.example

# Firebase / push credentials (client configs contain API keys)
google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json
firebase-service-account.json
mobile/google-services.json
mobile/GoogleService-Info.plist

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation files
/docs/
*.docx
*.pdf
*.html

