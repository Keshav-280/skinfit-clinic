# Physical iPhone — EC2 (nginx on port 80, no :3000 in URL):
EXPO_PUBLIC_API_URL=http://13.234.166.154
# Same Wi‑Fi as Mac — local Next.js:
# EXPO_PUBLIC_API_URL=http://192.168.0.105:3000
#
# After changing this URL on iOS you MUST rebuild the dev client (ATS + baked config):
#   cd mobile && npx expo prebuild --platform ios --clean && npx expo run:ios --device
# Then: npm run start:clear  and open the app (not Expo Go).

# Free Apple "Personal Team" (no $99/yr program): required to install on iPhone without
# Push / Sign in with Apple provisioning errors. Real iOS push needs paid Apple Developer.
# EXPO_PUBLIC_IOS_PERSONAL_TEAM=1

# --- Local dev checklist (physical device) ---
# 1. Repo root:  npm run dev          (Next.js on 0.0.0.0:3000)
# 2. Verify Mac: curl http://192.168.0.110:3000
# 3. iPhone Safari: open same URL — must load before the app will work
# 4. mobile/:     npm run start:clear  (reload env after editing this file)
# 5. After app.json iOS changes: npm run ios  (rebuild dev client once)
# Simulator only: EXPO_PUBLIC_API_URL=http://localhost:3000
# Android emulator: http://10.0.2.2:3000

# Android FCM: copy Firebase → Project settings → Your apps → Android → download google-services.json
# to mobile/google-services.json (gitignored — never commit). Template: google-services.json.example
# EAS cloud builds: eas secret:create --scope project --type file --name GOOGLE_SERVICES_JSON --value ./google-services.json
# (app.config.js writes it at build time). Restrict API keys in Google Cloud Console (Android app only).
# EXPO_PUBLIC_CAPTURE_DEBUG=1
# Scan debug preview overlay in capture/scan flows
# EXPO_PUBLIC_SCAN_DEBUG_PREVIEW=1

EXPO_PUBLIC_CHAT_DOCTOR_E2EE_DISABLED=1

# Google Sign-In (@react-native-google-signin): webClientId is REQUIRED on iOS and Android.
# Create a **Web application** OAuth client in Google Cloud Console and paste its client ID here.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID is optional (native iOS client) but does NOT replace the web ID.
# Google Console redirect URI: only http://localhost:3000/api/auth/oauth/callback/google
# (private IPs like 192.168.x.x are rejected). Physical device: use native sign-in after
# `npx expo run:ios`, or ngrok HTTPS for browser OAuth — see mobile/lib/oauthSignIn.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS native Google also needs this reversed URL scheme in the app (auto via prebuild plugin):
# com.googleusercontent.apps.<IOS_CLIENT_ID_PREFIX> — rebuild after changing: npx expo run:ios --device
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APPLE_SERVICES_ID=
# Native Sign in with Apple on iPhone requires a **paid** Apple Developer Program account.
# Free "Personal Team" cannot provision this capability. Leave unset for local device dev; use Google.
# When enrolled: EXPO_PUBLIC_ENABLE_NATIVE_APPLE_SIGNIN=1 then npx expo prebuild --platform ios
EXPO_PUBLIC_ENABLE_NATIVE_APPLE_SIGNIN=
