{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my.skinfitwellness.in",
        "EXPO_PUBLIC_CHAT_DOCTOR_E2EE_DISABLED": "1"
      }
    },
    "preview-ios": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my.skinfitwellness.in",
        "EXPO_PUBLIC_CHAT_DOCTOR_E2EE_DISABLED": "1",
        "EXPO_PUBLIC_IOS_PERSONAL_TEAM": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my.skinfitwellness.in"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
