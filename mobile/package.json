{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "android:apk": "cd android && ./gradlew assembleRelease -x lint -x lintVitalAnalyzeRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas": "eas",
    "eas:android": "eas build --platform android --profile preview --non-interactive",
    "eas:android:local": "eas build --platform android --profile preview --local",
    "prebuild": "expo prebuild",
    "verify:ios-ats": "node scripts/verify-ios-ats.js",
    "mediapipe:verify-model": "test -f assets/models/face_landmarker.task || (echo 'Missing assets/models/face_landmarker.task' && exit 1)",
    "mediapipe:download-model": "curl -fsSL \"https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task\" -o assets/models/face_landmarker.task"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/drawer": "^7.9.8",
    "@react-navigation/native": "^7.1.8",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "^56.0.4",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "jpeg-js": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mediapipe": "^0.6.0",
    "react-native-nitro-modules": "^0.35.7",
    "react-native-quick-base64": "^3.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.2"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.7",
