# Python FastAPI inference — mount face_analysis_tool + local /models weights
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*
COPY apps/ml-worker/python/requirements-worker.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
ENV PYTHONPATH=/app/face_analysis
COPY apps/ml-worker/python/backbone_offline.py /app/patches/backbone_offline.py
# face_analysis_tool mounted at runtime via compose volume
EXPOSE 8765
CMD ["sh", "-c", "cd /app/face_analysis && uvicorn api_server:app --host 0.0.0.0 --port 8765"]
