FROM node:22-alpine
WORKDIR /app
RUN addgroup -S skinfit && adduser -S skinfit -G skinfit
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY services/shared ./services/shared
COPY src ./src
COPY apps/ml-worker ./apps/ml-worker
RUN mkdir -p /uploads && chown -R skinfit:skinfit /uploads
USER skinfit
CMD ["npx", "tsx", "--tsconfig", "apps/ml-worker/tsconfig.json", "apps/ml-worker/src/worker.ts"]
