FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libgl1 libglib2.0-0 libxcb1 \
  && python3 -m venv /opt/mask-venv \
  && rm -rf /var/lib/apt/lists/*
COPY apps/ml-worker/python/requirements-mask-restrict.txt /tmp/requirements-mask-restrict.txt
COPY apps/ml-worker/python/requirements-identity.txt /tmp/requirements-identity.txt
RUN /opt/mask-venv/bin/pip install --no-cache-dir -r /tmp/requirements-mask-restrict.txt -r /tmp/requirements-identity.txt \
  && /opt/mask-venv/bin/python3 -c "from insightface.app import FaceAnalysis; FaceAnalysis(name='buffalo_sc', providers=['CPUExecutionProvider']).prepare(ctx_id=-1)"
ENV MASK_RESTRICT_PYTHON=/opt/mask-venv/bin/python3
ENV CAPTURE_PREVIEW_PYTHON=/opt/mask-venv/bin/python3
ENV HOME=/home/skinfit NPM_CONFIG_CACHE=/app/.npm MPLCONFIGDIR=/app/.matplotlib
RUN groupadd -r skinfit && useradd -r -g skinfit -d /home/skinfit skinfit \
  && mkdir -p /home/skinfit/.config /home/skinfit/.insightface /app/.npm /app/.matplotlib /uploads \
  && chown -R skinfit:skinfit /home/skinfit /app /uploads
COPY package.json package-lock.json ./
# tsx is a devDependency — install explicitly; do not use `npx tsx` at runtime (needs network + home dir).
RUN npm ci --omit=dev && npm install --no-save tsx@^4.21.0
COPY services/shared ./services/shared
COPY src ./src
COPY apps/ml-worker ./apps/ml-worker
RUN chown -R skinfit:skinfit /app /uploads
USER skinfit
CMD ["node_modules/.bin/tsx", "--tsconfig", "apps/ml-worker/tsconfig.json", "apps/ml-worker/src/worker.ts"]
