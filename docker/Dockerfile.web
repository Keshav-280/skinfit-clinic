FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY services/shared/package.json ./services/shared/
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Dummy URL for any build-time code paths that touch the DB (runtime uses compose env).
ARG LOCAL_POSTGRES_URL=postgresql://skinfit:skinfit_local_dev@postgres:5432/skinfit
ENV LOCAL_POSTGRES_URL=${LOCAL_POSTGRES_URL}
# Next inlines NEXT_PUBLIC_* at build time; production NODE_ENV hides debug without this.
ARG NEXT_PUBLIC_CAPTURE_DEBUG=0
ENV NEXT_PUBLIC_CAPTURE_DEBUG=${NEXT_PUBLIC_CAPTURE_DEBUG}
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV MPLCONFIGDIR=/app/.matplotlib
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libgl1 libglib2.0-0 libxcb1 \
  && python3 -m venv /opt/identity-venv \
  && rm -rf /var/lib/apt/lists/*
COPY apps/ml-worker/python/requirements-identity.txt /tmp/requirements-identity.txt
COPY scripts/requirements-sdetect-qr.txt /tmp/requirements-sdetect-qr.txt
COPY apps/ml-worker/python/face_identity_infer.py /app/apps/ml-worker/python/face_identity_infer.py
COPY scripts/sdetect_decode_pdf_qr.py /app/scripts/sdetect_decode_pdf_qr.py
RUN /opt/identity-venv/bin/pip install --no-cache-dir -r /tmp/requirements-identity.txt \
  && /opt/identity-venv/bin/pip install --no-cache-dir -r /tmp/requirements-sdetect-qr.txt \
  && /opt/identity-venv/bin/python3 -c "from insightface.app import FaceAnalysis; FaceAnalysis(name='buffalo_sc', providers=['CPUExecutionProvider']).prepare(ctx_id=-1)"
ENV CAPTURE_PREVIEW_PYTHON=/opt/identity-venv/bin/python3
ENV SDETECT_QR_PYTHON=/opt/identity-venv/bin/python3
RUN groupadd -r skinfit && useradd -r -g skinfit -d /home/skinfit skinfit \
  && mkdir -p /home/skinfit/.config /home/skinfit/.insightface /app/.matplotlib /uploads \
  && chown -R skinfit:skinfit /home/skinfit /app/.matplotlib /uploads
ENV HOME=/home/skinfit
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs ./node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs
COPY --from=builder /app/node_modules/pdfjs-dist/legacy/build/pdf.mjs ./node_modules/pdfjs-dist/legacy/build/pdf.mjs
RUN chown -R skinfit:skinfit /app
USER skinfit
EXPOSE 3000
CMD ["node", "server.js"]
