FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY services/shared/package.json ./services/shared/
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Dummy URL for any build-time code paths that touch the DB (runtime uses compose env).
ARG LOCAL_POSTGRES_URL=postgresql://skinfit:skinfit_local_dev@postgres:5432/skinfit
ENV LOCAL_POSTGRES_URL=${LOCAL_POSTGRES_URL}
# Next inlines NEXT_PUBLIC_* at build time; production NODE_ENV hides debug without this.
ARG NEXT_PUBLIC_CAPTURE_DEBUG=1
ENV NEXT_PUBLIC_CAPTURE_DEBUG=${NEXT_PUBLIC_CAPTURE_DEBUG}
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# MediaPipe face-mask clip (restrict_mask_to_face.py) — needs glibc; Alpine wheels fail.
# opencv-python-headless pulls cv2; bookworm-slim needs X/GL runtime libs even headless.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libgl1 libglib2.0-0 libxcb1 \
  && python3 -m venv /opt/mask-venv \
  && rm -rf /var/lib/apt/lists/*
COPY apps/ml-worker/python/requirements-mask-restrict.txt /tmp/requirements-mask-restrict.txt
RUN /opt/mask-venv/bin/pip install --no-cache-dir -r /tmp/requirements-mask-restrict.txt
ENV MASK_RESTRICT_PYTHON=/opt/mask-venv/bin/python3
ENV MPLCONFIGDIR=/app/.matplotlib
RUN groupadd -r skinfit && useradd -r -g skinfit -d /home/skinfit skinfit \
  && mkdir -p /home/skinfit/.config /app/.matplotlib /uploads \
  && chown -R skinfit:skinfit /home/skinfit /app/.matplotlib /uploads
ENV HOME=/home/skinfit
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY apps/ml-worker/python/restrict_mask_to_face.py ./apps/ml-worker/python/restrict_mask_to_face.py
RUN chown -R skinfit:skinfit /app
USER skinfit
EXPOSE 3000
CMD ["node", "server.js"]
