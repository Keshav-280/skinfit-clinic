# Face annotator (Medixora front photos). Plain Node, no dependencies, no login: the link is the secret.
# Served by nginx at /annotateimages/. Photos and annotations live in the /data volume, never in git.
FROM node:22-alpine
WORKDIR /app
COPY tools/face-annotator/server.mjs tools/face-annotator/index.html tools/face-annotator/fetch-front.mjs /app/
ENV DATA_DIR=/data HOST=0.0.0.0 PORT=5050 BASE_PATH=/annotateimages
EXPOSE 5050
RUN mkdir -p /data && chown node:node /data
USER node
CMD ["node", "server.mjs"]
