# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/skinfit

# Never commit .env or .env.local — this file is the safe template only.

# Patient session JWT (min 32 chars). Also used to sign OAuth state cookies.
SESSION_SECRET=

# Public site URL for OAuth redirect URIs (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Web application client)
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional native client IDs (token `aud` must match one of these)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Apple — native iOS (expo-apple-authentication identityToken)
APPLE_BUNDLE_ID=app.skinfit.clinic

# Apple — web + Android OAuth (Services ID + .p8 key)
# Return URL: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/callback/apple
# Also register mobile deep link: skinfit://oauth/apple
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
